  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "{job=\"avalanche\"}",
        "query": {
          "label": "node",
          "stream": "{job=\"avalanche\"}",
          "type": 1
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "logger",
        "label": "Logger",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "{job=\"avalanche\", node=~\"$node\"}",
