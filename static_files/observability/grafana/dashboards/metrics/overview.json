    {
      "type": "stat",
      "title": "L1 validators",
      "description": "Number of active L1 validators that the P-Chain records, over all L1s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(avalanche_platformvm_active_l1_validators{job=\"avalanche\"})",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
